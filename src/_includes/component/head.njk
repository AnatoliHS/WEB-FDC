<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{% if title %}{{ title }}{% else %}Aura Dental — Riverside, Lakeview & Hillcrest{% endif %}
  </title>
  <meta name="description"
    content="{% if description %}{{ description }}{% else %}Aura Dental provides comprehensive dental care in Riverside, Lakeview, and Hillcrest. Book your appointment today for cleanings, Invisalign, implants, and more.{% endif %}" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://example.com{{ page.url }}" />

  <!-- Open Graph -->
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}Aura Dental{% endif %}" />
  <meta property="og:description"
    content="Gentle care, brighter smiles. Comprehensive dental care across three locations." />
  <meta property="og:image" content="/assets/reception.png" />
  <meta property="og:url" content="https://example.com{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Aura Dental" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Aura Dental" />
  <meta name="twitter:description" content="Gentle care, brighter smiles." />
  <meta name="twitter:image" content="/assets/reception.png" />

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Google Fonts: Cormorant Garamond (display) + Inter (body) -->
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" />

  <!-- Preload hero image for LCP -->
  <link rel="preload" as="image" href="/assets/reception.png" fetchpriority="high" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/style.css?v=32" />

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
</head>