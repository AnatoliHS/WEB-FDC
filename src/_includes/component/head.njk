<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO Tags -->
  <title>{{ site.name }} – {{ site.title }}</title>
  <meta name="description" content="{{ site.name }} provides professional restoration services for homes and businesses, including water damage, fire and smoke recovery, mold remediation, and full rebuilds. From emergency response to final repair, we restore properties with care and clarity." />
  <meta name="keywords" content="Restoration Services, Water Damage Restoration, Fire Damage Repair, Mold Remediation, Property Restoration, Emergency Restoration, Belleville, Quinte West, Prince Edward County, MOPS INC" />
  <meta name="author" content="{{ site.name }}" />
  <meta name="robots" content="index, follow" />

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.url }}" />
  <meta property="og:title" content="{{ site.name }} – {{ site.title }}" />
  <meta property="og:description" content="Professional restoration services for homes and businesses. Water damage, fire & smoke recovery, mold remediation, and full rebuilds." />
  <meta property="og:image" content="{{ site.url }}assets/mops-maid.jpg" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="{{ site.url }}" />
  <meta property="twitter:title" content="{{ site.name }} – {{ site.title }}" />
  <meta property="twitter:description" content="From emergency response to final repair — we restore properties with care and clarity." />
  <meta property="twitter:image" content="{{ site.url }}assets/mops-maid.jpg" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Fontshare: Switzer -->
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,700&display=swap" rel="stylesheet">

  <!-- Core Stylesheet -->
  <link rel="stylesheet" href="/style.css" />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
  <link rel="manifest" href="/assets/site.webmanifest" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HomeAndConstructionBusiness",
    "name": "{{ site.name }}",
    "description": "Professional restoration services for homes and businesses, including water damage, fire and smoke recovery, mold remediation, and full rebuilds.",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "250 Sidney Street",
      "addressLocality": "Belleville",
      "addressRegion": "ON",
      "postalCode": "K8P 3Z3",
      "addressCountry": "CA"
    },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Belleville, ON" },
      { "@type": "AdministrativeArea", "name": "Quinte West, ON" },
      { "@type": "AdministrativeArea", "name": "Prince Edward County, ON" }
    ]
  }
  </script>
  <!-- Cloudflare Turnstile API -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>