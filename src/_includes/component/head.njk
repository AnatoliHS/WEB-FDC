<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{% if title %}{{ title }}{% else %}Family Dental Centre — Belleville, Cobourg & Frankford, ON{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}Family Dental Centre provides comprehensive dental care in Belleville, Cobourg, and Frankford, Ontario. Book your appointment today for cleanings, Invisalign, implants, and more.{% endif %}" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://familydentalcentre.com{{ page.url }}" />

  <!-- Open Graph -->
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}Family Dental Centre{% endif %}" />
  <meta property="og:description" content="We bring smiles to life. Comprehensive dental care across three Ontario locations." />
  <meta property="og:image" content="/assets/hero-fdc.png" />
  <meta property="og:url" content="https://familydentalcentre.com{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Family Dental Centre" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Family Dental Centre" />
  <meta name="twitter:description" content="We bring smiles to life." />
  <meta name="twitter:image" content="/assets/hero-fdc.png" />

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Google Fonts: Cormorant Garamond (display) + Inter (body) -->
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Preload hero image for LCP -->
  <link rel="preload" as="image" href="/assets/hero-fdc.png" fetchpriority="high" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/style.css" />

  <!-- Favicon placeholder -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🦷</text></svg>" />
</head>