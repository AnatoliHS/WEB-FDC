  <div class="container">
    <div class="nav-brand">
      <a href="#hero" style="display: flex; align-items: center; gap: 12px;">
        <svg id="Layer_1" class="nav-logo" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" version="1.1"
          xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 512.7 196.3" alt="Mops Inc. Logo">
          <defs>
            <linearGradient id="logo-linear-gradient" x1="413.1" y1="2.7" x2="413.1" y2="193.5"
