<script>
  /* ─── Navbar scroll state ─── */
  window.addEventListener('scroll', () => {
    const nb = document.getElementById('navbar');
    nb.classList.toggle('scrolled', window.scrollY > 60);
  });

  /* ─── Mobile menu toggle ─── */
  function toggleMenu() {
    const navbar  = document.getElementById('navbar');
    const links   = document.getElementById('nav-links');
    const btn     = document.getElementById('mobile-toggle');
    const isOpen  = navbar.classList.toggle('menu-open');
    links.classList.toggle('open');
    btn.setAttribute('aria-expanded', isOpen);
  }

  /* ─── Smooth-scroll + auto-close ─── */
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        document.getElementById('navbar').classList.remove('menu-open');
        document.getElementById('nav-links').classList.remove('open');
        document.getElementById('mobile-toggle').setAttribute('aria-expanded', 'false');
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      });
    });

    /* ─── IntersectionObserver for scroll-reveal ─── */
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal, .reveal-up, .reveal-left, .reveal-right').forEach(el => io.observe(el));

    /* ─── Count-up numbers ─── */
    const countIO = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const target = parseInt(el.dataset.target, 10);
        const suffix = el.dataset.suffix || '';
        const dur = 1500;
        const start = performance.now();
        (function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          el.textContent = Math.floor(p * (2 - p) * target) + suffix;
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = target + suffix;
        })(start);
        obs.unobserve(el);
      });
    }, { threshold: 0.3 });
    document.querySelectorAll('[data-target]').forEach(el => countIO.observe(el));

    /* ─── FAQ accordion ─── */
    document.querySelectorAll('.faq-item').forEach(item => {
      const btn = item.querySelector('.faq-question');
      const body = item.querySelector('.faq-answer');
      if (!btn || !body) return;
      btn.addEventListener('click', () => {
        const open = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(i => {
          i.classList.remove('open');
          i.querySelector('.faq-answer').style.maxHeight = null;
        });
        if (!open) {
          item.classList.add('open');
          body.style.maxHeight = body.scrollHeight + 'px';
        }
      });
    });

    /* ─── Reviews slider ─── */
    const track = document.querySelector('.reviews-track');
    const cards = document.querySelectorAll('.review-card');
    const prevBtn = document.querySelector('.reviews-prev');
    const nextBtn = document.querySelector('.reviews-next');
    if (track && cards.length) {
      let idx = 0;
      function getVisible() {
        return window.innerWidth <= 640 ? 1 : window.innerWidth <= 1024 ? 2 : 3;
      }
      function slideTo(n) {
        const vis = getVisible();
        idx = Math.max(0, Math.min(n, cards.length - vis));
        const w = cards[0].getBoundingClientRect().width;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 24;
        track.style.transform = `translateX(-${idx * (w + gap)}px)`;
      }
      if (prevBtn) prevBtn.addEventListener('click', () => slideTo(idx - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => slideTo(idx + 1));
      window.addEventListener('resize', () => slideTo(idx));

      /* Autoplay */
      let auto = setInterval(() => slideTo(idx + 1 > cards.length - getVisible() ? 0 : idx + 1), 5000);
      track.closest('.reviews-slider')?.addEventListener('mouseenter', () => clearInterval(auto));
      track.closest('.reviews-slider')?.addEventListener('mouseleave', () => {
        auto = setInterval(() => slideTo(idx + 1 > cards.length - getVisible() ? 0 : idx + 1), 5000);
      });
    }

    /* ─── Services Accordion + Images sync ─── */
    const firstAccordionItem = document.querySelector('.service-accordion-item');
    if (firstAccordionItem) {
      const firstContent = firstAccordionItem.querySelector('.service-accordion-content');
      if (firstContent) {
        // Timeout to make sure render/reflow occurs before setting initial height
        setTimeout(() => {
          firstContent.style.maxHeight = firstContent.scrollHeight + 'px';
        }, 100);
      }
    }

    document.querySelectorAll('.service-accordion-item').forEach(item => {
      const header = item.querySelector('.service-accordion-header');
      const content = item.querySelector('.service-accordion-content');
      if (!header || !content) return;

      header.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        if (isActive) return;

        // Close any currently active accordion item
        document.querySelectorAll('.service-accordion-item.active').forEach(activeItem => {
          activeItem.classList.remove('active');
          const activeContent = activeItem.querySelector('.service-accordion-content');
          if (activeContent) {
            activeContent.style.maxHeight = null;
          }
        });

        // Open this accordion item
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + 'px';

        // Update active image
        const serviceId = item.dataset.service;
        document.querySelectorAll('.service-image-wrapper').forEach(imgWrap => {
          if (imgWrap.dataset.service === serviceId) {
            imgWrap.classList.add('active');
          } else {
            imgWrap.classList.remove('active');
          }
        });
      });
    });
  });
</script>