      </a>
    </div>

    <div class="nav-links" id="nav-links">
      <a href="#hero">Home</a>
      <a href="#mission">Our Mission</a>
      <a href="#reviews">Reviews</a>
      <a href="#faq">FAQ</a>
      <a href="#contact" class="btn btn-primary">Contact</a>
    </div>

    <div class="mobile-toggle" onclick="toggleMenu()">
      <span></span>
      <span></span>
      <span></span>
    </div>
