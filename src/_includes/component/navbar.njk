</nav>

<script>
  // Scroll Reveal Observer
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  let introParagraph;
  let introLines = [];

  function splitIntoLines() {
    introParagraph = document.querySelector('.reveal-text');
    if (!introParagraph) return;

    // Temporarily restore plain text to measure wrapping
    const text = introParagraph.innerText.replace(/\s+/g, ' ').trim();
    const words = text.split(' ');

    // Render temp spans
    introParagraph.innerHTML = words.map(word => `<span class="temp-word">${word}</span>`).join(' ');

    const tempSpans = introParagraph.querySelectorAll('.temp-word');
    const lines = [];
    let currentLine = [];
    let lastOffsetTop = -1;

    tempSpans.forEach(span => {
      const offsetTop = span.offsetTop;
      if (lastOffsetTop !== -1 && offsetTop !== lastOffsetTop) {
        lines.push(currentLine);
        currentLine = [];
      }
      currentLine.push(span.innerText);
      lastOffsetTop = offsetTop;
    });
    if (currentLine.length > 0) {
      lines.push(currentLine);
    }

    // Render lines with breaks
    introParagraph.innerHTML = lines.map(lineWords => {
      return `<span class="reveal-line">${lineWords.join(' ')}</span>`;
    }).join('<br>');

    introLines = introParagraph.querySelectorAll('.reveal-line');
  }

  // Defer execution until DOM is parsed to measure offsets correctly
  window.addEventListener('DOMContentLoaded', () => {
    splitIntoLines();
    window.addEventListener('resize', splitIntoLines);

    document.querySelectorAll('.reveal-text').forEach(text => {
      revealObserver.observe(text);
    });

    const revealCta = document.getElementById('reveal-cta');
    if (revealCta) revealObserver.observe(revealCta);

    document.querySelectorAll('.highlight-image').forEach(img => {
      revealObserver.observe(img);
    });

    document.querySelectorAll('.reveal-title').forEach(title => {
      revealObserver.observe(title);
    });

    document.querySelectorAll('.reveal-fade-in').forEach(el => {
      revealObserver.observe(el);
    });

    document.querySelectorAll('.faq-accordion details').forEach((item, index) => {
      item.style.setProperty('--faq-idx', index);
      revealObserver.observe(item);

      if (item.open) {
        item.classList.add('is-open');
      }

      const summary = item.querySelector('summary');
      if (summary) {
        summary.addEventListener('click', (e) => {
          e.preventDefault();
          if (item.dataset.animating === 'true') return;
          item.dataset.animating = 'true';

          const isOpen = item.open;

          if (!isOpen) {
            item.open = true;
            item.classList.add('is-open');

            const startHeight = summary.offsetHeight;
            const endHeight = item.scrollHeight;

            item.style.height = `${startHeight}px`;
            item.style.overflow = 'hidden';

            const anim = item.animate(
              { height: [`${startHeight}px`, `${endHeight}px`] },
              { duration: 300, easing: 'cubic-bezier(0.25, 1, 0.5, 1)' }
            );

            anim.onfinish = () => {
              item.style.height = '';
              item.style.overflow = '';
              item.dataset.animating = 'false';
            };
          } else {
            item.classList.remove('is-open');

            const startHeight = item.offsetHeight;
            const endHeight = summary.offsetHeight;

            item.style.height = `${startHeight}px`;
            item.style.overflow = 'hidden';

            const anim = item.animate(
              { height: [`${startHeight}px`, `${endHeight}px`] },
              { duration: 300, easing: 'cubic-bezier(0.25, 1, 0.5, 1)' }
            );

            anim.onfinish = () => {
              item.open = false;
              item.style.height = '';
              item.style.overflow = '';
              item.dataset.animating = 'false';
            };
          }
        });
      }
    });

    // Count Up Animation for Statistics Circles
    const countUpElements = document.querySelectorAll('.circle-number');
    if (countUpElements.length > 0) {
      const countUpObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const target = parseInt(el.getAttribute('data-target'), 10);
            const suffix = el.getAttribute('data-suffix') || '';
            const duration = 1500;
            const startTime = performance.now();

            function updateNumber(now) {
              const elapsed = now - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const easeProgress = progress * (2 - progress); // easeOutQuad
              const currentValue = Math.floor(easeProgress * target);
              el.innerText = currentValue + suffix;

              if (progress < 1) {
                requestAnimationFrame(updateNumber);
              } else {
                el.innerText = target + suffix;
              }
            }

            requestAnimationFrame(updateNumber);
            observer.unobserve(el);
          }
        });
      }, { threshold: 0.15 });

      countUpElements.forEach(el => countUpObserver.observe(el));
    }

    // Trust Section Carousel and Timeline Progress Logic
    const timelineItems = document.querySelectorAll('.trust-timeline-item');
    const carouselSlides = document.querySelectorAll('.carousel-slide');
    
    if (timelineItems.length > 0 && carouselSlides.length > 0) {
      let activeIndex = 0;
      let intervalId = null;
      let startTime = null;
      const duration = 8000; // 8 seconds per slide
      let paused = false;

      function updateSlide(index) {
        timelineItems.forEach((item, idx) => {
          const line = item.querySelector('.progress-bar-line');
          if (idx !== index) {
            item.classList.remove('active');
            if (line) line.style.width = '0%';
          } else {
            item.classList.add('active');
          }
        });

        carouselSlides.forEach((slide, idx) => {
          if (idx === index) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });

        activeIndex = index;
      }

      function startTimer() {
        if (intervalId) clearInterval(intervalId);
        startTime = performance.now();
        
        intervalId = setInterval(() => {
          if (!paused) {
            let nextIndex = (activeIndex + 1) % timelineItems.length;
            updateSlide(nextIndex);
            startTime = performance.now();
          }
        }, duration);
      }

      // Progress bar smooth update frame loop
      function drawProgress() {
        if (intervalId) {
          const activeItem = timelineItems[activeIndex];
          if (activeItem && !paused) {
            const line = activeItem.querySelector('.progress-bar-line');
            if (line) {
              const elapsed = performance.now() - startTime;
              const progress = Math.min((elapsed / duration) * 100, 100);
              line.style.width = `${progress}%`;
            }
          }
        }
        requestAnimationFrame(drawProgress);
      }

      // Initialize
      updateSlide(0);
      
      const trustSection = document.querySelector('.trust-section');
      const trustObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            startTimer();
            requestAnimationFrame(drawProgress);
          } else {
            if (intervalId) {
              clearInterval(intervalId);
              intervalId = null;
            }
          }
        });
      }, { threshold: 0.15 });

      if (trustSection) {
        trustObserver.observe(trustSection);
      }

      timelineItems.forEach((item, index) => {
        item.addEventListener('click', () => {
          updateSlide(index);
          startTimer();
        });
      });
    }

    // Reviews Slider Logic
    const reviewsTrack = document.querySelector('.reviews-slider-track');
    const reviewCards = document.querySelectorAll('.review-card');
    const reviewsNextBtn = document.querySelector('.reviews-controls .next-btn');
    const reviewsPrevBtn = document.querySelector('.reviews-controls .prev-btn');
    const reviewsDotsContainer = document.querySelector('.reviews-controls .reviews-dots');

    if (reviewsTrack && reviewCards.length && reviewsNextBtn && reviewsPrevBtn && reviewsDotsContainer) {
      let currentIdx = 0;
      let autoplayTimer = null;
      const autoplayDelay = 6000;

      function getVisibleCount() {
        if (window.innerWidth <= 600) return 1;
        if (window.innerWidth <= 992) return 2;
        return 3;
      }

      function updateSliderPosition() {
        const visible = getVisibleCount();
        const total = reviewCards.length;
        const maxIdx = Math.max(0, total - visible);

        if (currentIdx > maxIdx) currentIdx = maxIdx;
        if (currentIdx < 0) currentIdx = 0;

        const firstCard = reviewCards[0];
        const cardWidth = firstCard.getBoundingClientRect().width;
        const trackStyle = window.getComputedStyle(reviewsTrack);
        const gap = parseFloat(trackStyle.columnGap) || 30;

        const offset = currentIdx * (cardWidth + gap);
        reviewsTrack.style.transform = `translateX(-${offset}px)`;

        const dots = reviewsDotsContainer.querySelectorAll('.reviews-dot');
        dots.forEach((dot, idx) => {
          if (idx === currentIdx) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      function rebuildDots() {
        reviewsDotsContainer.innerHTML = '';
        const visible = getVisibleCount();
        const total = reviewCards.length;
        const totalSteps = total - visible + 1;

        for (let i = 0; i < totalSteps; i++) {
          const dot = document.createElement('div');
          dot.classList.add('reviews-dot');
          if (i === currentIdx) dot.classList.add('active');
          dot.addEventListener('click', () => {
            currentIdx = i;
            updateSliderPosition();
            resetAutoplay();
          });
          reviewsDotsContainer.appendChild(dot);
        }
      }

      function navigateReviews(dir) {
        const visible = getVisibleCount();
        const total = reviewCards.length;
        const maxIdx = total - visible;

        if (dir === 'next') {
          if (currentIdx >= maxIdx) {
            currentIdx = 0;
          } else {
            currentIdx++;
          }
        } else {
          if (currentIdx <= 0) {
            currentIdx = maxIdx;
          } else {
            currentIdx--;
          }
        }
        updateSliderPosition();
        resetAutoplay();
      }

      reviewsNextBtn.addEventListener('click', () => navigateReviews('next'));
      reviewsPrevBtn.addEventListener('click', () => navigateReviews('prev'));

      let resizeDebounce;
      window.addEventListener('resize', () => {
        clearTimeout(resizeDebounce);
        resizeDebounce = setTimeout(() => {
          rebuildDots();
          updateSliderPosition();
        }, 100);
      });

      function startAutoplay() {
        stopAutoplay();
        autoplayTimer = setInterval(() => {
          navigateReviews('next');
        }, autoplayDelay);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function resetAutoplay() {
        startAutoplay();
      }

      // Pause auto-rotation when hovering card/slider
      const container = document.querySelector('.reviews-slider-container');
      if (container) {
        container.addEventListener('mouseenter', stopAutoplay);
        container.addEventListener('mouseleave', startAutoplay);
      }

      // Initial execution
      rebuildDots();
      updateSliderPosition();
      startAutoplay();
    }
  });

  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 50) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }

    // Parallax smoke calibration
    const smoke = document.querySelector('.hero-smoke');
    if (smoke) {
      const scrollY = window.scrollY;
      const heroHeight = window.innerHeight;
      if (scrollY > 0 && scrollY <= heroHeight) {
        const progress = Math.min(scrollY / (heroHeight * 0.7), 1); // reach full opacity at 70% scroll
        const translateY = scrollY * -0.35; // scroll up faster than next section
        const opacity = 0.35 + progress * 0.6; // from 0.35 to 0.95
        smoke.style.setProperty('transform', `translateY(${translateY}px)`, 'important');
        smoke.style.setProperty('opacity', opacity, 'important');
      } else if (scrollY === 0) {
        smoke.style.transform = '';
        smoke.style.opacity = '';
      }
    }

    // Text Reveal Logic (Line by Line)
    if (!introParagraph) {
      introParagraph = document.querySelector('.reveal-text');
    }
    if (introParagraph && introLines.length > 0) {
      const rect = introParagraph.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const visibility = (windowHeight - rect.top) / windowHeight;
      // Start revealing when the text is 30% up from the bottom of the screen
      // Finish revealing when it reaches 75% up from the bottom
      const startThreshold = 0.30;
      const endThreshold = 0.75;
      const progress = Math.min(Math.max((visibility - startThreshold) / (endThreshold - startThreshold), 0), 1);

      const L = introLines.length;
      const overlap = 0.25; // 25% overlap between consecutive lines
      introLines.forEach((line, k) => {
        const startFraction = (k * (1 - overlap)) / (L - (L - 1) * overlap);
        const duration = 1 / (L - (L - 1) * overlap);
        const endFraction = startFraction + duration;

        const lineProgress = Math.min(Math.max((progress - startFraction) / (endFraction - startFraction), 0), 1);
        line.style.backgroundSize = `${lineProgress * 100}% 100%`;
      });
    }
  });

  function toggleMenu() {
    const navbar = document.getElementById('navbar');
    const navLinks = document.getElementById('nav-links');
    navbar.classList.toggle('menu-open');
    navLinks.classList.toggle('open');
  }

  // Smooth scroll and auto-close mobile drawer
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = this.getAttribute('href');
      if (targetId === '#') return;

      const navbar = document.getElementById('navbar');
      const navLinks = document.getElementById('nav-links');

      navbar.classList.remove('menu-open');
      navLinks.classList.remove('open');

      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth'
        });
      }
    });
  });
</script>