            <path class="cls-2"
              d="M435.5,122.5v-52.1c0-15,7.8-23.8,22.4-23.8s22.4,8.9,22.4,23.8v10.3h-14.4v-11.2c0-6.4-3-9-7.6-9s-7.6,2.6-7.6,9v54.2c0,6.4,3,8.9,7.6,8.9s7.6-2.5,7.6-8.9v-14.8h14.4v13.7c0,15-7.8,23.8-22.4,23.8s-22.4-8.9-22.4-23.8Z" />
