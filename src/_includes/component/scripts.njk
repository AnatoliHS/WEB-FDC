<script>
  /* ═══════════════════════════════════════════
     FDC — Scripts
     ═══════════════════════════════════════════ */

  // ── Footer Year ──────────────────────────────
  const yearEl = document.getElementById('footer-year');
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // ── Navbar Scroll Behavior ────────────────────
  const navbar = document.getElementById('navbar');
  if (navbar) {
    const SCROLL_THRESHOLD = 60;
    let lastScroll = 0;

    const updateNavbar = () => {
      const currentScroll = Math.max(window.scrollY, 0); // Clamp to 0 to avoid iOS bounce issues

      if (currentScroll > SCROLL_THRESHOLD) {
        navbar.classList.add('navbar--scrolled');
      } else {
        navbar.classList.remove('navbar--scrolled');
      }

      // Auto-hide behavior on desktop
      const isDesktop = window.innerWidth > 768;
      if (isDesktop) {
        if (currentScroll > lastScroll && currentScroll > 0) {
          // Scrolling down immediately from top -> hide
          navbar.classList.add('navbar--hidden');
        } else if (currentScroll < lastScroll) {
          // Scrolling up -> show
          navbar.classList.remove('navbar--hidden');
        }
      } else {
        // Always display on mobile screens
        navbar.classList.remove('navbar--hidden');
      }

      lastScroll = currentScroll;
    };

    window.addEventListener('scroll', updateNavbar, { passive: true });
    updateNavbar();
  }

  // ── Mobile Menu ───────────────────────────────
  const hamburger = document.getElementById('navbar-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  if (hamburger && mobileMenu) {
    const openMenu = () => {
      hamburger.setAttribute('aria-expanded', 'true');
      mobileMenu.setAttribute('aria-hidden', 'false');
      hamburger.classList.add('is-open');
      mobileMenu.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      hamburger.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      hamburger.classList.remove('is-open');
      mobileMenu.classList.remove('is-open');
      document.body.style.overflow = '';
    };

    hamburger.addEventListener('click', () => {
      if (mobileMenu.classList.contains('is-open')) closeMenu();
      else openMenu();
    });

    // Dedicated Close Button
    const closeBtn = document.getElementById('mobile-menu-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeMenu);
    }

    // Close on backdrop click (outside the panel)
    mobileMenu.addEventListener('click', e => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    // Close on mobile link click
    mobileMenu.querySelectorAll('.mobile-nav-link, .mobile-cta').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close on ESC
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) closeMenu();
    });
  }

  // ── Scroll Reveal (IntersectionObserver) ─────
  const revealEls = document.querySelectorAll('.reveal, .reveal-up, .reveal-left, .reveal-right');

  if (revealEls.length > 0) {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    revealEls.forEach(el => revealObserver.observe(el));
  }

  // ── Treatments Tab/Accordion ─────────────────
  const treatmentItems = document.querySelectorAll('.treatment-tab');
  const treatmentPanels = document.querySelectorAll('.treatment-panel');
  const treatmentPanelWrap = document.querySelector('.treatment-panel-wrap');
  const treatmentTabsContainer = document.querySelector('.treatment-tabs');

  let isMobileLayout = false;

  const arrangeTreatments = () => {
    const isMobile = window.innerWidth <= 1024;
    if (isMobile) {
      if (!isMobileLayout) {
        // Move panels to be siblings of their tabs on mobile
        treatmentItems.forEach(tab => {
          const target = tab.dataset.treatment;
          const panel = document.querySelector(`.treatment-panel[data-treatment="${target}"]`);
          if (panel) {
            tab.after(panel);
          }
        });
        isMobileLayout = true;

        // Initialize max-height for active panel on page load / layout switch
        const activePanel = document.querySelector('.treatment-panel.active');
        if (activePanel) {
          activePanel.style.maxHeight = activePanel.scrollHeight + 'px';
          activePanel.style.opacity = '1';
        }
      }
    } else {
      if (isMobileLayout) {
        // Move panels back to their original desktop container
        treatmentPanels.forEach(panel => {
          if (treatmentPanelWrap) {
            treatmentPanelWrap.appendChild(panel);
            panel.style.maxHeight = '';
            panel.style.opacity = '';
          }
        });
        isMobileLayout = false;
      }
    }
  };

  if (treatmentItems.length > 0) {
    // Initial arrangement
    arrangeTreatments();
    window.addEventListener('resize', arrangeTreatments);

    treatmentItems.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.treatment;
        const isMobile = window.innerWidth <= 1024;

        if (isMobile) {
          const activePanel = document.querySelector(`.treatment-panel[data-treatment="${target}"]`);
          const isAlreadyActive = tab.classList.contains('active');

          // Find the currently open panel and tab before classes are updated
          const currentlyOpenPanel = document.querySelector('.treatment-panel.active');
          const currentlyOpenTab = document.querySelector('.treatment-tab.active');
          let heightAdjustment = 0;

          if (currentlyOpenPanel && currentlyOpenTab) {
            // If the currently open tab is situated ABOVE the clicked tab,
            // collapsing it will shift the clicked tab up by the panel's height.
            if (currentlyOpenTab.getBoundingClientRect().top < tab.getBoundingClientRect().top) {
              heightAdjustment = currentlyOpenPanel.offsetHeight;
            }
          }

          // Reset all tabs and collapse all panels smoothly
          treatmentItems.forEach(t => {
            t.classList.remove('active');
            t.setAttribute('aria-expanded', 'false');
          });
          treatmentPanels.forEach(p => {
            p.classList.remove('active');
            p.setAttribute('aria-hidden', 'true');
            p.style.maxHeight = '0';
            p.style.opacity = '0';
          });

          // Toggle the clicked accordion item
          if (!isAlreadyActive && activePanel) {
            tab.classList.add('active');
            tab.setAttribute('aria-expanded', 'true');
            activePanel.classList.add('active');
            activePanel.setAttribute('aria-hidden', 'false');

            // Set max-height to its exact scrollHeight for smooth animation
            activePanel.style.maxHeight = activePanel.scrollHeight + 'px';
            activePanel.style.opacity = '1';

            // Calculate exact target Y position accounting for collapsing panels above
            const navbarHeight = document.getElementById('navbar')?.offsetHeight || 80;
            const tabCurrentY = tab.getBoundingClientRect().top + window.scrollY;
            const targetY = tabCurrentY - heightAdjustment - navbarHeight - 15; // 15px breathing space

            window.scrollTo({
              top: targetY,
              behavior: 'smooth'
            });
          }
        } else {
          // Desktop behavior (standard tabs)
          treatmentItems.forEach(t => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');

          treatmentPanels.forEach(panel => {
            panel.classList.remove('active');
            panel.setAttribute('aria-hidden', 'true');
          });
          const activePanel = document.querySelector(`.treatment-panel[data-treatment="${target}"]`);
          if (activePanel) {
            activePanel.classList.add('active');
            activePanel.setAttribute('aria-hidden', 'false');
          }
        }
      });
    });
  }

  // ── Counter Animation ────────────────────────
  const counters = document.querySelectorAll('.counter-number');
  if (counters.length > 0) {
    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          const target = parseInt(el.dataset.target, 10);
          const duration = 1800;
          const step = target / (duration / 16);
          let current = 0;
          const timer = setInterval(() => {
            current += step;
            if (current >= target) {
              el.textContent = target.toLocaleString();
              clearInterval(timer);
            } else {
              el.textContent = Math.floor(current).toLocaleString();
            }
          }, 16);
          counterObserver.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(c => counterObserver.observe(c));
  }

  // ── Smooth Scroll ────────────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // ── Hero Parallax Animation (Universal Cross-Browser Support) ──
  const hero = document.getElementById('hero');
  const heroBg = hero?.querySelector('.hero-bg');
  const heroContent = hero?.querySelector('.hero-content');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && (heroBg || heroContent) && !prefersReducedMotion) {
    let isHeroVisible = false;

    const parallaxObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isHeroVisible = entry.isIntersecting;
      });
    }, { threshold: 0 });

    parallaxObserver.observe(hero);

    let ticking = false;

    const updateParallax = () => {
      if (!isHeroVisible) {
        ticking = false;
        return;
      }

      const scrollY = window.scrollY;
      const heroHeight = hero.offsetHeight;

      if (scrollY <= heroHeight) {
        // Translate background downward (slower scroll)
        if (heroBg) {
          const bgTranslate = scrollY * 0.2; // 20% speed offset (20vh equivalent at 100vh)
          heroBg.style.transform = `translateY(${bgTranslate}px)`;
        }
        // Translate content upward (faster scroll)
        if (heroContent) {
          const contentTranslate = scrollY * -0.12; // 12% speed offset (-12vh equivalent at 100vh)
          heroContent.style.transform = `translateY(${contentTranslate}px)`;
        }
      }
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true });

    // Run once on init
    updateParallax();
  }
</script>