<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Column 1: Bio & Social -->
      <div class="footer-col">
        <h3>{{ site.name }}</h3>
        <p>A human-first professional cleaning service based in Belleville, ON. Dedicated to providing vibrant,
          judgment-free cleanliness for homes, offices, and vacation rentals.</p>
        <div class="footer-social">
          <a href="#" class="social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Company Navigation -->
      <div class="footer-col">
        <h3>Company</h3>
        <div class="footer-links">
          <a href="#hero">Home</a>
          <a href="#trust">About</a>
          <a href="#mission">Our Mission</a>
          <a href="#faq">Common Questions</a>
          <a href="#contact">Get in Touch</a>
        </div>
      </div>

      <!-- Column 3: Services -->
      <div class="footer-col">
        <h3>Services</h3>
        <div class="footer-links">
          <a href="#commercial-spaces">Commercial</a>
          <a href="#hotel-takeover">Hotel Takeover</a>
          <a href="#vacation-rentals">Vacation Rentals</a>
          <a href="#municipal-spaces">Municipal & Gov</a>
        </div>
      </div>

      <!-- Column 4: Location & Contact -->
      <div class="footer-col">
        <h3>Contact</h3>
        <div class="footer-links">
          <a href="tel:{{ site.phone }}">{{ site.phone }}</a>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          <p style="color: rgba(255, 255, 255, 0.7); margin-top: 10px;">{{ site.address }}</p>
        </div>
      </div>
    </div>

    <!-- Monumental Brand Row -->
    <div class="footer-brand-row">
      <img src="/assets/mops-inc-logo-white.svg" alt="Mops Inc. Logo" class="footer-brand-logo">
      <span class="footer-tagline">Vibrant Cleanliness</span>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <p>&copy; {{ site.year or '2026' }} {{ site.name or 'Mops Inc.' }} All Rights Reserved.</p>
      </div>
      <div class="footer-bottom-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>